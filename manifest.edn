;; yotei — actor manifest (kotoba-native; supersedes actor-manifest.jsonld)
;; Scheduling commons (Calendly inversion) — free, no booker-harvest, no double-book.
;; ADR-2606072200 (remediation Phase A of ADR-2606071800)
{:actor/id        "yotei"
 :actor/glyph     "予定"
 :actor/tier      :tier-b
 :actor/integrates ["musubi" "shinka" "society6"]
 ;; Re-homed 2026-08-06 (owner decision) from yotei.etzhayyim.com, which never
 ;; resolved, to a path under the shared app host. The old value is kept as a
 ;; historical alias rather than deleted: it is the `did:web` these lexicons
 ;; were minted under, and a DID that silently changes identity is worse than
 ;; one that is recorded as retired.
 :actor/domain    "app.itonami.cloud"
 :actor/domain-retired ["yotei.etzhayyim.com"]
 :actor/purpose   "Calendly-inverse scheduling commons — calendar owners (member or actor) publish availability and accept 予約, FREE with no seat tiers and NO booker-data harvesting. 予約 are append-only kotoba Datoms; a proposal overlapping a confirmed 予約 is structurally refused (no-double-book); confirmations are member-signed. kotoba-EAVT-native, Murakumo-only, no urgency/scarcity dark-patterns."
 :actor/status    :r1
 :actor/adr       "2606072200"
 :actor/wire-projection "wire/actor-manifest.jsonld"

 ;; ── itonami.cloud の default app として (owner decision 2026-08-06) ──────────
 ;;
 ;; itonami.cloud の default app は「それぞれ app org に所属する」。所属は
 ;; **app 側が自分で宣言する**ことにして、host 側に app の一覧を持たせない —
 ;; 一覧を host が持つと、app を足すたびに 2 箇所を直すことになり、いずれ
 ;; 片方だけが更新される。ルータの registry はこの宣言群から生成する
 ;; (west.yml を repos.edn から生成するのと同じ向き)。
 ;;
 ;; :app/org は cloud-itonami-app の Organization(テナント)。所有権・membership・
 ;; did:web はそこが持ち、この repo は実装だけを持つ。両者は :app/org の
 ;; organization-id で結ぶ。
 :app/mount       "/yotei"
 :app/host        "app.itonami.cloud"
 :app/default?    true
 :app/org         {:organization/id "yotei"
                   :organization/name "yotei — 予約"
                   :organization/did "did:web:app.itonami.cloud:org:yotei"}
 :app/repo        "cloud-itonami/yotei"
 :app/surface     [{:path "/yotei/c/:calendar" :method :get  :doc "空いている時間(公開)"}
                   {:path "/yotei/c/:calendar/select" :method :post :doc "時間を選ぶ"}
                   {:path "/yotei/c/:calendar/propose" :method :post :doc "申し込む(未確定)"}
                   {:path "/yotei/health" :method :get :doc "health"}]

 :actor/charter-rider
 {:rider/version "2.0"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1"  :gate/name "no-tier"               :gate/rule "free; no paid seat tiers / subscription; no external inflow (§1.3)"}
  {:gate/id "G2"  :gate/name "no-harvest"            :gate/rule "no booker profiling / data resale / CRM funnel; booking PII → com.etzhayyim.encrypted.* and used only to hold the slot (ADR-2605181100)"}
  {:gate/id "G3"  :gate/name "kotoba-eavt-native"    :gate/rule "calendar/availability/event/booking are append-only kotoba Datoms; no RisingWave/SQL/Cypher (corrects legacy manifest)"}
  {:gate/id "G4"  :gate/name "no-double-book"        :gate/rule "a proposal whose slot overlaps an existing confirmed booking on the same calendar is structurally refused (not last-write-wins)"}
  {:gate/id "G5"  :gate/name "no-server-key"         :gate/rule "booking confirmations are member-signed (passkey/ERC-4337); yotei holds no key (ADR-2605231525); server signature refused"}
  {:gate/id "G6"  :gate/name "wellbecoming-anti-dark":gate/rule "honest availability only; no scarcity/urgency ('3 spots left') / FOMO nudges; optimize coordination, never conversion"}
  {:gate/id "G7"  :gate/name "murakumo-only"         :gate/rule "NL command parsing / narration via KotobaLLM 127.0.0.1:4000; no external LLM (ADR-2605215000)"}
  {:gate/id "G8"  :gate/name "consent-bound"         :gate/rule "member DID-signed consent before a booking holds a slot or shares contact handles"}]

 :actor/cells
 [{:cell/id "calendar"  :cell/kind :datalog   :cell/runtime :kotoba :cell/doc "calendar + availability + event + booking Datoms"}
  {:cell/id "propose"   :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "availability → free slots (no-double-book G4) → proposed booking"}
  {:cell/id "confirm"   :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "consent (G8) → member-signed confirm (G5) → social announce"}]

 :actor/lexicons
 ["com.etzhayyim.apps.yotei.analyzeSchedule"
  "com.etzhayyim.apps.yotei.autoReschedule"
  "com.etzhayyim.apps.yotei.cancelBooking"
  "com.etzhayyim.apps.yotei.cancelEvent"
  "com.etzhayyim.apps.yotei.confirmBooking"
  "com.etzhayyim.apps.yotei.createCalendar"
  "com.etzhayyim.apps.yotei.createEvent"
  "com.etzhayyim.apps.yotei.deleteCalendar"
  "com.etzhayyim.apps.yotei.describe"
  "com.etzhayyim.apps.yotei.getAvailability"
  "com.etzhayyim.apps.yotei.getBooking"
  "com.etzhayyim.apps.yotei.getCalendar"
  "com.etzhayyim.apps.yotei.getEvent"
  "com.etzhayyim.apps.yotei.getOpenSlots"
  "com.etzhayyim.apps.yotei.health"
  "com.etzhayyim.apps.yotei.listBookings"
  "com.etzhayyim.apps.yotei.listCalendars"
  "com.etzhayyim.apps.yotei.listEvents"
  "com.etzhayyim.apps.yotei.proposeBooking"
  "com.etzhayyim.apps.yotei.removeAvailability"
  "com.etzhayyim.apps.yotei.setAvailability"
  "com.etzhayyim.apps.yotei.suggestSlots"
  "com.etzhayyim.apps.yotei.updateEvent"
  "com.etzhayyim.yotei.availability"
  "com.etzhayyim.yotei.booking"]

 :actor/siblings
 {:yoro    "public booking page host"
  :musubi  "covenant ceremony scheduling"
  :society6 "governance-meeting scheduling"}}
