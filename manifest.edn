;; yotei — actor manifest (kotoba-native; supersedes actor-manifest.jsonld)
;; Scheduling commons (Calendly inversion) — free, no booker-harvest, no double-book.
;; ADR-2606072200 (remediation Phase A of ADR-2606071800)
{:actor/id        "yotei"
 :actor/glyph     "予定"
 :actor/tier      :tier-b
 :actor/integrates ["musubi" "shinka" "society6"]
 ;; Re-homed 2026-08-06 (owner decision) from yotei.etzhayyim.com, which never
 ;; resolved, to a path under the shared app host. The old value is kept as a
 ;; historical alias rather than deleted: it is the `did:web` these lexicons
 ;; were minted under, and a DID that silently changes identity is worse than
 ;; one that is recorded as retired.
 :actor/domain    "app.itonami.cloud"
 :actor/domain-retired ["yotei.etzhayyim.com"]
 :actor/purpose   "Calendly-inverse scheduling commons — calendar owners (member or actor) publish availability and accept 予約, FREE with no seat tiers and NO booker-data harvesting. 予約 are append-only kotoba Datoms; a proposal overlapping a confirmed 予約 is structurally refused (no-double-book); confirmations are member-signed. kotoba-EAVT-native, Murakumo-only, no urgency/scarcity dark-patterns."
 :actor/status    :r1
 :actor/adr       "2606072200"
 :actor/wire-projection "wire/actor-manifest.jsonld"

 ;; ── app surface は blueprint.edn が正本（ADR-2608093000 D1）─────────────
 ;;
 ;; mount / org / surface はここに :app/* として書いてあったが、それは既存を
 ;; 確認せずに作った 4 つ目の記述子形式だった —— この org は blueprint.edn を
 ;; 1,393 repo で既に使っており、cloud-itonami-app の Fleet 画面はそこから
 ;; 生成されたカタログを読む。重複させると、どちらが正かを知らない読み手が
 ;; 必ず片方だけを更新する。
 ;;
 ;;   mount / org / surface  → blueprint.edn
 ;;   actor の gate / cell / lexicon（下）→ このファイル
 ;;
 ;; :actor/id == repo 名 == script 名 == blueprint の :mount セグメント。
 ;; 構造上ひとつの文字列なので、対応表は要らない。

 :actor/charter-rider
 {:rider/version "2.0"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1"  :gate/name "no-tier"               :gate/rule "free; no paid seat tiers / subscription; no external inflow (§1.3)"}
  {:gate/id "G2"  :gate/name "no-harvest"            :gate/rule "no booker profiling / data resale / CRM funnel; 予約 PII → com.etzhayyim.encrypted.* and used only to hold the slot (ADR-2605181100)"}
  {:gate/id "G3"  :gate/name "kotoba-eavt-native"    :gate/rule "calendar/availability/event/予約 are append-only kotoba Datoms; no RisingWave/SQL/Cypher (corrects legacy manifest)"}
  {:gate/id "G4"  :gate/name "no-double-book"        :gate/rule "a proposal whose slot overlaps an existing confirmed 予約 on the same calendar is structurally refused (not last-write-wins)"}
  {:gate/id "G5"  :gate/name "no-server-key"         :gate/rule "予約 confirmations are member-signed (passkey/ERC-4337); yotei holds no key (ADR-2605231525); server signature refused. 2026-08-15 (ADR-2608150900): a delegate key may confirm unattended ONLY inside an owner-signed envelope (yotei.delegation) that names the tables, hours, seating time, largest party, horizon and an expiry — every field re-derived at confirm time, never read from server state. Still not yotei's key, and still not yotei's decision"}
  {:gate/id "G9"  :gate/name "capacity-is-not-a-counter" :gate/rule "a room's tables are separate calendars, so 'free' is always yoyaku/is-free? (yotei.seat); no capacity counter beside the 予約 log that could disagree with it, and public availability is de-duplicated instants — never how many tables remain (G6)"}
  {:gate/id "G6"  :gate/name "wellbecoming-anti-dark":gate/rule "honest availability only; no scarcity/urgency ('3 spots left') / FOMO nudges; optimize coordination, never conversion"}
  {:gate/id "G7"  :gate/name "murakumo-only"         :gate/rule "NL command parsing / narration via KotobaLLM 127.0.0.1:4000; no external LLM (ADR-2605215000)"}
  {:gate/id "G8"  :gate/name "consent-bound"         :gate/rule "member DID-signed consent before a 予約 holds a slot or shares contact handles"}]

 :actor/cells
 [{:cell/id "calendar"  :cell/kind :datalog   :cell/runtime :kotoba :cell/doc "calendar + availability + event + 予約 Datoms"}
  {:cell/id "propose"   :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "availability → free slots (no-double-book G4) → proposed 予約"}
  {:cell/id "confirm"   :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "consent (G8) → member-signed confirm (G5) → social announce"}]

 :actor/lexicons
 ["cloud.itonami.apps.yotei.analyzeSchedule"
  "cloud.itonami.apps.yotei.autoReschedule"
  "cloud.itonami.apps.yotei.cancelYoyaku"
  "cloud.itonami.apps.yotei.cancelEvent"
  "cloud.itonami.apps.yotei.confirmYoyaku"
  "cloud.itonami.apps.yotei.createCalendar"
  "cloud.itonami.apps.yotei.createEvent"
  "cloud.itonami.apps.yotei.deleteCalendar"
  "cloud.itonami.apps.yotei.describe"
  "cloud.itonami.apps.yotei.getAvailability"
  "cloud.itonami.apps.yotei.getYoyaku"
  "cloud.itonami.apps.yotei.getCalendar"
  "cloud.itonami.apps.yotei.getEvent"
  "cloud.itonami.apps.yotei.getOpenSlots"
  "cloud.itonami.apps.yotei.health"
  "cloud.itonami.apps.yotei.listYoyaku"
  "cloud.itonami.apps.yotei.listCalendars"
  "cloud.itonami.apps.yotei.listEvents"
  "cloud.itonami.apps.yotei.proposeYoyaku"
  "cloud.itonami.apps.yotei.removeAvailability"
  "cloud.itonami.apps.yotei.setAvailability"
  "cloud.itonami.apps.yotei.suggestSlots"
  "cloud.itonami.apps.yotei.updateEvent"
  "cloud.itonami.yotei.availability"
  "cloud.itonami.yotei.yoyaku"]

 :actor/siblings
 {:yoro    "public 予約 page host"
  :musubi  "covenant ceremony scheduling"
  :society6 "governance-meeting scheduling"}}
