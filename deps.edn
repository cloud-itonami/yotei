{:paths ["src" "resources"]
 ;; jp-go-digital-design-system — デジタル庁デザインシステム(DADS)。**この
 ;; ワークスペースの基本 design system**(オーナー判断 2026-08-05)。予約ページの
 ;; app CSS は `--hig-*` トークン契約だけで書いてあり、jp-go-dds.tokens/bridge-css
 ;; が DADS primitive の上に再定義するので、基盤が動いても無改造で追従する。
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/html.git"
         :git/sha "44fe37a9120cb7753b974d921c7fc87448dace45"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
         :git/sha "cc8f4849af5def7ea535fd6c0b8a623ccca645e9"}}
 :aliases
 {;; The Worker build. shadow-cljs reads :deps via this alias, and the macro
  ;; in yotei.edge.inline needs jp-go-dds on the classpath at *compile* time
  ;; to inline dds.css into the bundle.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
