{:paths ["src" "resources"]
 ;; jp-go-digital-design-system — デジタル庁デザインシステム(DADS)。**この
 ;; ワークスペースの基本 design system**(オーナー判断 2026-08-05)。予約ページの
 ;; app CSS は `--hig-*` トークン契約だけで書いてあり、jp-go-dds.tokens/bridge-css
 ;; が DADS primitive の上に再定義するので、基盤が動いても無改造で追従する。
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.html"}
        ;; calendar — the event/attendee/RSVP model yotei.schedule builds on.
        ;; Consolidated in from cloud-itonami-app, which was the only caller
        ;; and used three of its functions.
        io.github.kotoba-lang/calendar
        {:git/url "https://github.com/kotoba-lang/calendar.git"
         :git/sha "01163ded2616a604c24807f2c1e867b0db53510c"}
        ;; org-ietf-ical — RFC 5545. The .ics a visitor adds to their own
        ;; calendar. Pinned past the fix that keeps the UTC "Z" through parse
        ;; and emit: without it a 予約 would land at the attendee's local clock
        ;; face rather than the agreed instant.
        io.github.kotoba-lang/org-ietf-ical
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/org.ietf.ical"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases
 {;; The Worker build. shadow-cljs reads :deps via this alias, and the macro
  ;; in yotei.edge.inline needs jp-go-dds on the classpath at *compile* time
  ;; to inline dds.css into the bundle.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
